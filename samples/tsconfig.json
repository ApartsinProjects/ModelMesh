{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "quickstart/typescript/**/*.ts",
    "system/typescript/**/*.ts",
    "cdk/typescript/**/*.ts",
    "connectors/typescript/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
