{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@modelmesh/core": ["src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../samples/quickstart/typescript/**/*.ts",
    "../../samples/system/typescript/**/*.ts",
    "../../samples/cdk/typescript/**/*.ts",
    "../../samples/connectors/typescript/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
