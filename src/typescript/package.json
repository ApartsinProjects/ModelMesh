{
  "name": "@nistrapa/modelmesh-core",
  "version": "0.2.0",
  "description": "One integration point for all your AI providers. Automatic failover, free-tier aggregation, and capability-based routing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/cdk/browser-provider.d.ts",
      "import": "./dist/cdk/browser-provider.js",
      "require": "./dist/cdk/browser-provider.js",
      "default": "./dist/cdk/browser-provider.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js",
      "require": "./dist/capabilities.js",
      "default": "./dist/capabilities.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./exceptions": {
      "types": "./dist/exceptions.d.ts",
      "import": "./dist/exceptions.js",
      "require": "./dist/exceptions.js",
      "default": "./dist/exceptions.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js",
      "require": "./dist/usage.js",
      "default": "./dist/usage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "docs": "typedoc"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "routing",
    "failover",
    "model-mesh"
  ],
  "author": "Sasha Apartsin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ApartsinProjects/ModelMesh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.0",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
